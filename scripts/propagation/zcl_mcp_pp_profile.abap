CLASS zcl_mcp_pp_profile DEFINITION PUBLIC FINAL CREATE PUBLIC.
  PUBLIC SECTION.
    INTERFACES if_oo_adt_classrun.
  PRIVATE SECTION.
    CONSTANTS c_mode TYPE string VALUE '{{MODE}}'.     " SHOW | SET | CLEAR | ADDFILE | REMOVEFILE
    CONSTANTS c_value TYPE string VALUE '{{VALUE}}'.
    METHODS show IMPORTING out TYPE REF TO if_oo_adt_classrun_out.
    METHODS profile_file IMPORTING out TYPE REF TO if_oo_adt_classrun_out.
ENDCLASS.

CLASS zcl_mcp_pp_profile IMPLEMENTATION.
  METHOD if_oo_adt_classrun~main.
    " Trusts the Cloud Connector simulator as reverse proxy in the running ICM (as SMICM → Parameters →
    " Change Value): icm/trusted_reverse_proxy_0. Not written to any profile; an ICM restart drops it.
    " CLEAR empties it again. ADDFILE also appends it to the instance profile file (byte backup
    " <profile>.mcp-pp-backup first), REMOVEFILE restores that backup. Generated by
    " scripts/propagation/pp-profile.ts; deleted after the run.
    DATA: lt_vals TYPE icm_value_t, lv_one TYPE icmparamstring.
    out->write( |before:| ).
    show( out ).
    IF c_mode = 'ADDFILE' OR c_mode = 'REMOVEFILE'.
      profile_file( out ).
    ENDIF.
    IF c_mode = 'SET' OR c_mode = 'CLEAR' OR c_mode = 'ADDFILE' OR c_mode = 'REMOVEFILE'.
      IF c_mode = 'SET' OR c_mode = 'ADDFILE'.
        lv_one = c_value.
        APPEND lv_one TO lt_vals.
      ENDIF.
      CALL FUNCTION 'ICM_SET_VECTOR_PARM'
        EXPORTING name = 'icm/trusted_reverse_proxy' value_tab = lt_vals
        EXCEPTIONS icm_op_failed = 1 icm_get_serv_failed = 2 icm_no_http_service = 3 icm_auth_failed = 4 OTHERS = 5.
      out->write( |{ c_mode } icm/trusted_reverse_proxy: rc { sy-subrc }| ).
      out->write( |after:| ).
      show( out ).
    ENDIF.
  ENDMETHOD.

  METHOD profile_file.
    DATA: lv_pf TYPE string, lv_bak TYPE string, lv_x TYPE xstring, lv_text TYPE string, lv_add TYPE xstring.
    cl_spfl_profile_parameter=>get_value( EXPORTING name = 'pf' IMPORTING value = lv_pf ).
    IF lv_pf IS INITIAL.
      cl_spfl_profile_parameter=>get_value( EXPORTING name = 'SAPPROFILE' IMPORTING value = lv_pf ).
    ENDIF.
    lv_bak = |{ lv_pf }.mcp-pp-backup|.
    out->write( |instance profile: { lv_pf }| ).
    " RZ10 keeps profiles under the file name without directory, in upper case
    DATA(lv_base) = to_upper( substring_after( val = lv_pf sub = `/profile/` ) ).
    SELECT pfname, versnr FROM tpfht WHERE pfname = @lv_base INTO TABLE @DATA(lt_db).
    out->write( |RZ10 database copies of { lv_base }: { lines( lt_db ) }| ).
    LOOP AT lt_db INTO DATA(ls_db).
      SELECT COUNT(*) FROM tpfet WHERE pfname = @ls_db-pfname AND versnr = @ls_db-versnr AND parname LIKE 'icm/server_port%' INTO @DATA(lv_ports).
      out->write( |  version { ls_db-versnr }: { lv_ports } icm/server_port line(s); if that is fewer than in the file, the copy is out of date| ).
    ENDLOOP.
    IF c_mode = 'ADDFILE'.
      OPEN DATASET lv_pf FOR INPUT IN BINARY MODE.
      READ DATASET lv_pf INTO lv_x.
      CLOSE DATASET lv_pf.
      lv_text = cl_abap_codepage=>convert_from( lv_x ).
      IF lv_text CS 'icm/trusted_reverse_proxy_0'.
        out->write( |the profile already names icm/trusted_reverse_proxy_0: not changed| ).
        RETURN.
      ENDIF.
      OPEN DATASET lv_bak FOR INPUT IN BINARY MODE.
      IF sy-subrc = 0.
        CLOSE DATASET lv_bak.
      ELSE.
        OPEN DATASET lv_bak FOR OUTPUT IN BINARY MODE.
        TRANSFER lv_x TO lv_bak.
        CLOSE DATASET lv_bak.
        out->write( |backup: { lv_bak } ({ xstrlen( lv_x ) } bytes)| ).
      ENDIF.
      DATA(lv_nl) = cl_abap_char_utilities=>newline.
      DATA(lv_lines) = COND string( WHEN lv_text IS NOT INITIAL AND substring( val = lv_text off = strlen( lv_text ) - 1 len = 1 ) <> lv_nl THEN lv_nl ) &&
                       |# abap-config-mcp principal propagation test (docs/PRINCIPAL_PROPAGATION.md): trusted Cloud Connector simulator{ lv_nl }| &&
                       |icm/trusted_reverse_proxy_0 = { c_value }{ lv_nl }|.
      lv_add = cl_abap_codepage=>convert_to( lv_lines ).
      OPEN DATASET lv_pf FOR APPENDING IN BINARY MODE.
      TRANSFER lv_add TO lv_pf.
      CLOSE DATASET lv_pf.
      out->write( |appended to { lv_pf }:| ).
      out->write( lv_lines ).
    ELSE.
      OPEN DATASET lv_bak FOR INPUT IN BINARY MODE.
      IF sy-subrc <> 0.
        out->write( |no backup { lv_bak }: the profile file was not changed by ADDFILE, nothing restored| ).
        RETURN.
      ENDIF.
      READ DATASET lv_bak INTO lv_x.
      CLOSE DATASET lv_bak.
      OPEN DATASET lv_pf FOR OUTPUT IN BINARY MODE.
      TRANSFER lv_x TO lv_pf.
      CLOSE DATASET lv_pf.
      DELETE DATASET lv_bak.
      out->write( |restored { lv_pf } from the backup ({ xstrlen( lv_x ) } bytes); backup removed| ).
    ENDIF.
  ENDMETHOD.

  METHOD show.
    DATA: lt_vals TYPE icm_value_t, lv_single TYPE string.
    CALL FUNCTION 'ICM_GET_VECTOR_PARM'
      EXPORTING name = 'icm/trusted_reverse_proxy'
      CHANGING value_tab = lt_vals
      EXCEPTIONS OTHERS = 1.
    out->write( |  ICM vector icm/trusted_reverse_proxy (rc { sy-subrc }): { lines( lt_vals ) } entr{ COND string( WHEN lines( lt_vals ) = 1 THEN `y` ELSE `ies` ) }| ).
    LOOP AT lt_vals INTO DATA(lv_v).
      out->write( |    { lv_v }| ).
    ENDLOOP.
    CALL FUNCTION 'ICM_GET_PARM' EXPORTING name = `icm/trusted_reverse_proxy_0` IMPORTING value = lv_single EXCEPTIONS OTHERS = 1.
    out->write( |  ICM icm/trusted_reverse_proxy_0 (rc { sy-subrc }): { lv_single }| ).
  ENDMETHOD.
ENDCLASS.
