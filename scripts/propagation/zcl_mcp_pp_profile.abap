CLASS zcl_mcp_pp_profile DEFINITION PUBLIC FINAL CREATE PUBLIC.
  PUBLIC SECTION.
    INTERFACES if_oo_adt_classrun.
  PRIVATE SECTION.
    CONSTANTS c_mode TYPE string VALUE '{{MODE}}'.     " SHOW | SET | CLEAR
    CONSTANTS c_name TYPE spfl_parameter_name VALUE 'icm/trusted_reverse_proxy_0'.
    CONSTANTS c_value TYPE string VALUE '{{VALUE}}'.
ENDCLASS.

CLASS zcl_mcp_pp_profile IMPLEMENTATION.
  METHOD if_oo_adt_classrun~main.
    " Sets or clears icm/trusted_reverse_proxy_0 in the instance profile through SAP's profile API
    " (as RZ10/RZ11: file and DB, with a backup of the file, switched dynamically), and shows the
    " profile lines that name it. Generated by scripts/propagation/pp-profile.ts; deleted after the run.
    DATA: lv_profile TYPE string, lv_line TYPE string, lv_val TYPE string, lv_msg TYPE string,
          lt_par TYPE spfl_parameter_name_value_t, lt_err TYPE spfl_parameter_name_value_t,
          lt_msg TYPE spfl_parameter_error_message_t.
    cl_spfl_profile_parameter=>get_value( EXPORTING name = 'pf' IMPORTING value = lv_profile ).
    IF lv_profile IS INITIAL.
      cl_spfl_profile_parameter=>get_value( EXPORTING name = 'SAPPROFILE' IMPORTING value = lv_profile ).
    ENDIF.
    out->write( |instance profile: { lv_profile }| ).
    IF c_mode = 'SET' OR c_mode = 'CLEAR'.
      APPEND VALUE #( name = c_name value = COND #( WHEN c_mode = 'SET' THEN c_value ELSE `` ) ) TO lt_par.
      DATA(lv_rc) = cl_spfl_profile_parameter=>set_multi_para_in_file_and_db(
        EXPORTING it_modify_parameter = lt_par iv_file_name = lv_profile iv_create_file_backup = abap_true iv_dynamic_switch = abap_true
        IMPORTING et_erroneous_parameters = lt_err et_error_messages = lt_msg ).
      out->write( |{ c_mode }: rc { lv_rc }| ).
      LOOP AT lt_msg INTO DATA(ls_m).
        out->write( |  { ls_m-name }: { ls_m-message-type } { ls_m-message-message }| ).
      ENDLOOP.
    ENDIF.
    cl_spfl_profile_parameter=>get_value( EXPORTING name = c_name IMPORTING value = lv_val ).
    out->write( |runtime value: { lv_val }| ).
    OPEN DATASET lv_profile FOR INPUT IN TEXT MODE ENCODING DEFAULT IGNORING CONVERSION ERRORS.
    IF sy-subrc = 0.
      DO.
        READ DATASET lv_profile INTO lv_line.
        IF sy-subrc <> 0. EXIT. ENDIF.
        IF lv_line CS 'trusted_reverse_proxy' OR lv_line CS 'icm/server_port' OR lv_line CS 'HTTPS'.
          out->write( |profile: { lv_line }| ).
        ENDIF.
      ENDDO.
      CLOSE DATASET lv_profile.
    ELSE.
      out->write( |cannot read { lv_profile }| ).
    ENDIF.
  ENDMETHOD.
ENDCLASS.
