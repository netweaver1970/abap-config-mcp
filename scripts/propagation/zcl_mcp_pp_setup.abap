CLASS zcl_mcp_pp_setup DEFINITION PUBLIC FINAL CREATE PUBLIC.
  PUBLIC SECTION.
    INTERFACES if_oo_adt_classrun.
  PRIVATE SECTION.
    CONSTANTS c_mode TYPE string VALUE '{{MODE}}'.          " STATUS | APPLY | REVERT
    CONSTANTS c_user TYPE xubname VALUE '{{SAP_USER}}'.
    CONSTANTS c_proxy_param TYPE spfl_parameter_name VALUE 'icm/trusted_reverse_proxy_0'.
    CONSTANTS c_with_proxy TYPE abap_bool VALUE '{{WITH_PROXY}}'.
    METHODS b64 IMPORTING iv TYPE string RETURNING VALUE(rv) TYPE xstring.
    METHODS ca_cert RETURNING VALUE(rv) TYPE xstring.
    METHODS user_cert RETURNING VALUE(rv) TYPE xstring.
    METHODS proxy_cert RETURNING VALUE(rv) TYPE xstring.
    METHODS trusted_subjects RETURNING VALUE(rt) TYPE string_table.
    DATA mv_pse TYPE ssfpab.                                 " SSL server Standard: <DIR_INSTANCE>/sec/SAPSSLS.pse
ENDCLASS.

CLASS zcl_mcp_pp_setup IMPLEMENTATION.
  METHOD if_oo_adt_classrun~main.
    " Principal propagation test set-up on a lab system: trust a test CA in the SSL server PSE file
    " (SSFC_PUT_CERTIFICATE, as sapgenpse maintain_pk -a; a backup of the file is kept next to it), map the test user certificate's DN to one SAP user
    " (SUSR_USER_EXTID_SET, external ID type DN, as SM30 VUSREXTID), and trust the Cloud Connector simulator as reverse
    " proxy (icm/trusted_reverse_proxy_0, a dynamic change that a restart undoes). REVERT removes all
    " three. Generated by scripts/propagation/pp-setup.ts; deleted after the run.
    DATA: lv_ca_subj TYPE string, lv_ca_iss TYPE string, lv_ca_ser TYPE string,
          lv_u_subj  TYPE string, lv_u_iss TYPE string, lv_u_ser TYPE string,
          lv_p_subj  TYPE string, lv_p_iss TYPE string, lv_p_ser TYPE string,
          lv_dir     TYPE string,
          lv_file    TYPE string,
          lv_bak     TYPE string,
          lv_x       TYPE xstring,
          lv_val     TYPE string,
          lv_msg     TYPE string,
          ls_meta    TYPE spfl_parameter_metadata,
          lv_dummy   TYPE c LENGTH 1.
    TRY.
        cl_abap_pse=>parse_certificate( EXPORTING iv_certificite = ca_cert( )
                                        IMPORTING ev_subject = lv_ca_subj ev_issuer = lv_ca_iss ev_serialno = lv_ca_ser ).
        cl_abap_pse=>parse_certificate( EXPORTING iv_certificite = user_cert( )
                                        IMPORTING ev_subject = lv_u_subj ev_issuer = lv_u_iss ev_serialno = lv_u_ser ).
        cl_abap_pse=>parse_certificate( EXPORTING iv_certificite = proxy_cert( )
                                        IMPORTING ev_subject = lv_p_subj ev_issuer = lv_p_iss ev_serialno = lv_p_ser ).
        out->write( |CA:    { lv_ca_subj }| ).
        out->write( |USER:  { lv_u_subj }  (issuer { lv_u_iss })| ).
        out->write( |PROXY: { lv_p_subj }  (issuer { lv_p_iss })| ).

        cl_spfl_profile_parameter=>get_value( EXPORTING name = 'DIR_INSTANCE' IMPORTING value = lv_dir ).
        lv_file = |{ lv_dir }/sec/SAPSSLS.pse|.
        mv_pse = lv_file.
        lv_bak  = |{ lv_dir }/sec/SAPSSLS.pse.mcp-pp-backup|.
        DATA(lt_subjects) = trusted_subjects( ).
        DATA(lv_trusted) = xsdbool( line_exists( lt_subjects[ table_line = lv_ca_subj ] ) ).

        CASE c_mode.
          WHEN 'APPLY'.
            IF lv_trusted = abap_false.
              " backup of the PSE file, once
              OPEN DATASET lv_bak FOR INPUT IN BINARY MODE.
              IF sy-subrc = 0.
                CLOSE DATASET lv_bak.
              ELSE.
                OPEN DATASET lv_file FOR INPUT IN BINARY MODE.
                READ DATASET lv_file INTO lv_x.
                CLOSE DATASET lv_file.
                OPEN DATASET lv_bak FOR OUTPUT IN BINARY MODE.
                TRANSFER lv_x TO lv_bak.
                CLOSE DATASET lv_bak.
                out->write( |BACKUP: { lv_bak } ({ xstrlen( lv_x ) } bytes)| ).
              ENDIF.
              CALL FUNCTION 'SSFC_PUT_CERTIFICATE'
                EXPORTING profile = mv_pse certificate = ca_cert( )
                EXCEPTIONS ssf_krn_certexists = 1 OTHERS = 2.
              out->write( |TRUST: added { lv_ca_subj } to { mv_pse }: rc { sy-subrc }| ).
            ELSE.
              out->write( |TRUST: { lv_ca_subj } already trusted| ).
            ENDIF.
            " DN mapping for the user, as SM30 view VUSREXTID maintains it. The logon looks the DN up as
            " "CN=…, O=…, C=…" (comma and space), while the certificate parser prints "CN=…,O=…,C=…".
            " Bound to the issuer: behind a trusted reverse proxy ICM does not check the forwarded
            " certificate's issuer, so a DN-only mapping would accept any CA (tested on CAR).
            DATA(lv_dn) = replace( val = lv_u_subj sub = `,` with = `, ` occ = 0 ).
            DATA(lv_iss) = replace( val = lv_u_iss sub = `,` with = `, ` occ = 0 ).
            DATA(lt_ext_in) = VALUE extid_opt( ( extid = lv_dn issuer = lv_iss operation = 'I' ) ).
            CALL FUNCTION 'SUSR_USER_EXTID_SET'
              EXPORTING if_bname = c_user if_type = 'DN' it_extid = lt_ext_in
              EXCEPTIONS user_not_found = 1 empty_extid = 2 no_authority = 3 lock_failure = 4 hash_error = 5
                         hash_conflict = 6 db_error = 7 rulebased_certmapping = 8 OTHERS = 9.
            out->write( |MAP: { lv_dn } (issuer { lv_iss }) → { c_user }: rc { sy-subrc }| ).
            COMMIT WORK AND WAIT.
            IF c_with_proxy = abap_true.
              lv_val = |SUBJECT="{ lv_p_subj }", ISSUER="{ lv_p_iss }"|.
              DATA(lv_rc) = cl_spfl_profile_parameter=>change_value( EXPORTING name = c_proxy_param value = CONV #( lv_val ) IMPORTING msg = lv_msg ).
              out->write( |PROXY PARAM { c_proxy_param }: rc { lv_rc } { lv_msg }| ).
              IF lv_rc <> 0.
                " older pair of parameters for the same trust: the intermediary that may forward SSL_CLIENT_CERT
                lv_rc = cl_spfl_profile_parameter=>change_value( EXPORTING name = 'icm/HTTPS/trust_client_with_issuer' value = CONV #( lv_p_iss ) IMPORTING msg = lv_msg ).
                out->write( |PROXY PARAM icm/HTTPS/trust_client_with_issuer: rc { lv_rc } { lv_msg }| ).
                lv_rc = cl_spfl_profile_parameter=>change_value( EXPORTING name = 'icm/HTTPS/trust_client_with_subject' value = CONV #( lv_p_subj ) IMPORTING msg = lv_msg ).
                out->write( |PROXY PARAM icm/HTTPS/trust_client_with_subject: rc { lv_rc } { lv_msg }| ).
              ENDIF.
            ENDIF.
          WHEN 'REVERT'.
            IF lv_trusted = abap_true.
              CALL FUNCTION 'SSFC_REMOVECERTIFICATE'
                EXPORTING profile = mv_pse subject = lv_ca_subj issuer = lv_ca_iss serialno = lv_ca_ser
                EXCEPTIONS OTHERS = 1.
              out->write( |TRUST: removed { lv_ca_subj }: rc { sy-subrc }| ).
            ENDIF.
            " the PSE file back to its original bytes, from the backup APPLY took; then the backup goes
            OPEN DATASET lv_bak FOR INPUT IN BINARY MODE.
            IF sy-subrc = 0.
              READ DATASET lv_bak INTO lv_x.
              CLOSE DATASET lv_bak.
              IF xstrlen( lv_x ) > 0.
                OPEN DATASET lv_file FOR OUTPUT IN BINARY MODE.
                TRANSFER lv_x TO lv_file.
                CLOSE DATASET lv_file.
                DELETE DATASET lv_bak.
                out->write( |RESTORED: { lv_file } from the backup ({ xstrlen( lv_x ) } bytes); backup removed| ).
              ENDIF.
            ENDIF.
            CALL FUNCTION 'SUSR_USER_EXTID_DEL' EXPORTING if_bname = c_user
              EXCEPTIONS user_not_found = 1 no_authority = 2 lock_failure = 3 db_error = 4 OTHERS = 5.
            out->write( |MAP: external IDs of { c_user } removed: rc { sy-subrc }| ).
            COMMIT WORK AND WAIT.
            LOOP AT VALUE string_table( ( CONV string( c_proxy_param ) ) ( `icm/HTTPS/trust_client_with_issuer` ) ( `icm/HTTPS/trust_client_with_subject` ) ) INTO DATA(lv_clear).
              cl_spfl_profile_parameter=>get_value( EXPORTING name = CONV #( lv_clear ) IMPORTING value = lv_val ).
              IF lv_val IS NOT INITIAL.
                lv_rc = cl_spfl_profile_parameter=>change_value( EXPORTING name = CONV #( lv_clear ) value = `` IMPORTING msg = lv_msg ).
                out->write( |PARAM { lv_clear } cleared: rc { lv_rc } { lv_msg }| ).
              ENDIF.
            ENDLOOP.
        ENDCASE.

        IF c_mode <> 'STATUS'.
          CALL FUNCTION 'ICM_SSL_PSE_CHANGED' EXPORTING global = 1 EXCEPTIONS OTHERS = 1.
          out->write( |ICM told about the PSE change: rc { sy-subrc }| ).
        ENDIF.

        " state after
        LOOP AT trusted_subjects( ) INTO DATA(lv_s).
          out->write( |TRUSTED: { lv_s }| ).
        ENDLOOP.
        OPEN DATASET lv_bak FOR INPUT IN BINARY MODE.
        out->write( |BACKUP present: { COND string( WHEN sy-subrc = 0 THEN `yes` ELSE `no` ) }| ).
        CLOSE DATASET lv_bak.
        SELECT type, extid, status FROM usrextid WHERE bname = @c_user INTO TABLE @DATA(lt_ext).
        LOOP AT lt_ext INTO DATA(ls_e).
          out->write( |EXTID: { ls_e-type } { ls_e-extid } status { ls_e-status }| ).
        ENDLOOP.
        IF lt_ext IS INITIAL. out->write( |EXTID: none for { c_user }| ). ENDIF.
        LOOP AT VALUE string_table( ( `icm/trusted_reverse_proxy_0` ) ( `icm/HTTPS/trust_client_with_issuer` ) ( `icm/HTTPS/trust_client_with_subject` )
                                    ( `icm/HTTPS/verify_client` ) ( `login/certificate_mapping_rulebased` ) ) INTO DATA(lv_p).
          CLEAR: lv_val, ls_meta.
          cl_spfl_profile_parameter=>get_value( EXPORTING name = CONV #( lv_p ) IMPORTING value = lv_val ).
          cl_spfl_profile_parameter=>get_metadata( EXPORTING name = CONV #( lv_p ) IMPORTING metadata = ls_meta ).
          out->write( |PARAM { lv_p } = { lv_val } (dynamic { ls_meta-is_dynamic })| ).
        ENDLOOP.
      CATCH cx_root INTO DATA(lx).
        out->write( |ERROR { cl_abap_classdescr=>get_class_name( lx ) }: { lx->get_text( ) }| ).
    ENDTRY.
  ENDMETHOD.

  METHOD trusted_subjects.
    DATA: lt_list TYPE ssfbintab, lv_subj TYPE string.
    CALL FUNCTION 'SSFC_GET_CERTIFICATELIST' EXPORTING profile = mv_pse IMPORTING certificatelist = lt_list
      EXCEPTIONS ssf_krn_error = 1 ssf_krn_nomemory = 2 ssf_krn_nossflib = 3 ssf_krn_invalid_par = 4 ssf_krn_nocertificate = 5 OTHERS = 6.
    IF sy-subrc <> 0.
      APPEND |(certificate list of { mv_pse }: rc { sy-subrc })| TO rt.
    ENDIF.
    LOOP AT lt_list INTO DATA(lv_c).
      TRY.
          cl_abap_pse=>parse_certificate( EXPORTING iv_certificite = lv_c IMPORTING ev_subject = lv_subj ).
          APPEND lv_subj TO rt.
        CATCH cx_abap_pse.
      ENDTRY.
    ENDLOOP.
  ENDMETHOD.

  METHOD b64.
    CALL FUNCTION 'SCMS_BASE64_DECODE_STR' EXPORTING input = iv IMPORTING output = rv.
  ENDMETHOD.

  METHOD ca_cert.
    rv = b64( {{CA_B64}} ).
  ENDMETHOD.

  METHOD user_cert.
    rv = b64( {{USER_B64}} ).
  ENDMETHOD.

  METHOD proxy_cert.
    rv = b64( {{PROXY_B64}} ).
  ENDMETHOD.
ENDCLASS.
