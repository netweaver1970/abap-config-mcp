CLASS zcl_mcp_ag_sicf_clean DEFINITION PUBLIC FINAL CREATE PUBLIC.
  PUBLIC SECTION.
    INTERFACES if_oo_adt_classrun.
ENDCLASS.

CLASS zcl_mcp_ag_sicf_clean IMPLEMENTATION.
  METHOD if_oo_adt_classrun~main.
    " Deletes the engine's SICF nodes (ZMCP_CUST, ZMCP_DIAG and any node below them), children first,
    " with the ICF API that transaction SICF and abapGit use. For resetting a lab system before a
    " fresh abapGit install; generated by scripts/abapgit-install.ts --clean and deleted after the run.
    DATA lv_name TYPE icfname.
    SELECT icf_name, icfparguid, icfnodguid FROM icfservice
      WHERE icf_name IN ('ZMCP_CUST','ZMCP_DIAG') INTO TABLE @DATA(lt_nodes).
    DO 5 TIMES.
      IF lt_nodes IS INITIAL. EXIT. ENDIF.
      LOOP AT lt_nodes INTO DATA(ls_n).
        DATA(lv_idx) = sy-tabix.
        DELETE FROM icfapplcust WHERE icf_name = ls_n-icf_name AND icfparguid = ls_n-icfparguid.
        lv_name = ls_n-icf_name.
        cl_icf_tree=>if_icf_tree~delete_node(
          EXPORTING icfparguid = ls_n-icfparguid
          CHANGING  icf_name   = lv_name
          EXCEPTIONS node_has_childs = 5 OTHERS = 12 ).
        IF sy-subrc = 0.
          out->write( |deleted { ls_n-icf_name } (parent { ls_n-icfparguid })| ).
          DELETE lt_nodes INDEX lv_idx.
        ELSE.
          out->write( |not yet { ls_n-icf_name } (parent { ls_n-icfparguid }): rc { sy-subrc }| ).
        ENDIF.
      ENDLOOP.
    ENDDO.
    COMMIT WORK.
    out->write( |left: { lines( lt_nodes ) }| ).
  ENDMETHOD.
ENDCLASS.
