CLASS zcl_mcp_ag_install DEFINITION PUBLIC FINAL CREATE PUBLIC.
  PUBLIC SECTION.
    INTERFACES if_oo_adt_classrun.
  PRIVATE SECTION.
    CONSTANTS c_ag TYPE string VALUE '\PROGRAM={{ABAPGIT_PROGRAM}}'.
    CONSTANTS c_package TYPE devclass VALUE '{{PACKAGE}}'.
    CONSTANTS c_transport TYPE trkorr VALUE '{{TRANSPORT}}'.
    CONSTANTS c_repo_name TYPE string VALUE 'abap-config-mcp engine {{ENGINE_VERSION}}'.
    METHODS payload RETURNING VALUE(rt_lines) TYPE string_table.
ENDCLASS.

CLASS zcl_mcp_ag_install IMPLEMENTATION.

  METHOD if_oo_adt_classrun~main.
    " Installs the abap-config-mcp engine through abapGit, without its GUI: the same steps as
    " abapGit's "New Offline" + "Import zip" + "Pull", with every pull decision answered yes.
    " Generated by scripts/abapgit-install.ts with the repository's zip as payload; deleted after the run.
    DATA: lv_n      TYPE string,
          lv_b64    TYPE string,
          lv_zip    TYPE xstring,
          lr_srv    TYPE REF TO data,
          lr_repo   TYPE REF TO data,
          lr_files  TYPE REF TO data,
          lr_checks TYPE REF TO data,
          lr_log    TYPE REF TO data,
          lr_msgs   TYPE REF TO data,
          lv_reason TYPE string,
          lv_title  TYPE string VALUE `MCP install`,
          lv_logic  TYPE string VALUE `PREFIX`,
          lv_name   TYPE string,
          lo_srv    TYPE REF TO object,
          lo_repo   TYPE REF TO object,
          lo_log    TYPE REF TO object.
    FIELD-SYMBOLS: <srv> TYPE any, <repo> TYPE any, <files> TYPE any, <checks> TYPE any, <log> TYPE any,
                   <msgs> TYPE STANDARD TABLE, <tab> TYPE STANDARD TABLE, <f> TYPE any,
                   <ftab> TYPE ANY TABLE, <sub> TYPE any.

    lv_b64 = concat_lines_of( table = payload( ) ).
    CALL FUNCTION 'SCMS_BASE64_DECODE_STR' EXPORTING input = lv_b64 IMPORTING output = lv_zip.
    out->write( |ZIP { xstrlen( lv_zip ) } bytes, package { c_package }{ COND string( WHEN c_transport IS NOT INITIAL THEN |, request { c_transport }| ) }| ).

    TRY.
        " the repository service
        lv_n = c_ag && '\INTERFACE=ZIF_ABAPGIT_REPO_SRV'.
        CREATE DATA lr_srv TYPE REF TO (lv_n).
        ASSIGN lr_srv->* TO <srv>.
        lv_n = c_ag && '\CLASS=ZCL_ABAPGIT_REPO_SRV'.
        CALL METHOD (lv_n)=>get_instance RECEIVING ri_srv = <srv>.
        lo_srv = <srv>.

        " the package's offline repository: the existing one, else a new one
        lv_n = c_ag && '\INTERFACE=ZIF_ABAPGIT_REPO'.
        CREATE DATA lr_repo TYPE REF TO (lv_n).
        ASSIGN lr_repo->* TO <repo>.
        CALL METHOD lo_srv->('ZIF_ABAPGIT_REPO_SRV~GET_REPO_FROM_PACKAGE')
          EXPORTING iv_package = c_package
          IMPORTING ei_repo = <repo> ev_reason = lv_reason.
        IF <repo> IS INITIAL.
          lv_name = c_repo_name.
          CALL METHOD lo_srv->('ZIF_ABAPGIT_REPO_SRV~NEW_OFFLINE')
            EXPORTING iv_name = lv_name iv_package = c_package iv_folder_logic = lv_logic
            RECEIVING ri_repo = <repo>.
          out->write( |Offline repository created for { c_package }| ).
        ELSE.
          out->write( |Offline repository of { c_package } reused| ).
        ENDIF.
        lo_repo = <repo>.

        " import the zip, as "Import zip" does
        lv_n = c_ag && '\INTERFACE=ZIF_ABAPGIT_GIT_DEFINITIONS\TYPE=TY_FILES_TT'.
        CREATE DATA lr_files TYPE (lv_n).
        ASSIGN lr_files->* TO <files>.
        lv_n = c_ag && '\CLASS=ZCL_ABAPGIT_ZIP'.
        CALL METHOD (lv_n)=>load EXPORTING iv_xstr = lv_zip RECEIVING rt_files = <files>.
        CALL METHOD lo_repo->('ZIF_ABAPGIT_REPO~SET_FILES_REMOTE') EXPORTING it_files = <files>.
        ASSIGN lr_files->* TO <ftab>.
        out->write( |Files imported: { lines( <ftab> ) }| ).

        " the pull checks, every decision answered yes
        lv_n = c_ag && '\INTERFACE=ZIF_ABAPGIT_DEFINITIONS\TYPE=TY_DESERIALIZE_CHECKS'.
        CREATE DATA lr_checks TYPE (lv_n).
        ASSIGN lr_checks->* TO <checks>.
        CALL METHOD lo_repo->('ZIF_ABAPGIT_REPO~DESERIALIZE_CHECKS') RECEIVING rs_checks = <checks>.
        LOOP AT VALUE string_table( ( `OVERWRITE` ) ( `WARNING_PACKAGE` ) ( `DATA_LOSS` ) ) INTO DATA(lv_list).
          ASSIGN COMPONENT lv_list OF STRUCTURE <checks> TO <tab>.
          LOOP AT <tab> ASSIGNING FIELD-SYMBOL(<row>).
            ASSIGN COMPONENT 'DECISION' OF STRUCTURE <row> TO <f>.
            <f> = 'Y'.
            ASSIGN COMPONENT 'OBJ_NAME' OF STRUCTURE <row> TO FIELD-SYMBOL(<on>).
            ASSIGN COMPONENT 'OBJ_TYPE' OF STRUCTURE <row> TO FIELD-SYMBOL(<ot>).
            out->write( |  { lv_list }: { <ot> } { <on> } → yes| ).
          ENDLOOP.
        ENDLOOP.
        LOOP AT VALUE string_table( ( `REQUIREMENTS` ) ( `DEPENDENCIES` ) ) INTO lv_list.
          ASSIGN COMPONENT lv_list OF STRUCTURE <checks> TO <sub>.
          IF sy-subrc = 0.
            ASSIGN COMPONENT 'DECISION' OF STRUCTURE <sub> TO <f>.
            IF sy-subrc = 0. <f> = 'Y'. ENDIF.
          ENDIF.
        ENDLOOP.
        ASSIGN COMPONENT 'TRANSPORT' OF STRUCTURE <checks> TO <sub>.
        ASSIGN COMPONENT 'REQUIRED' OF STRUCTURE <sub> TO <f>.
        IF <f> = abap_true.
          IF c_transport IS INITIAL.
            out->write( |STOPPED: package { c_package } records changes; give a Workbench request.| ).
            RETURN.
          ENDIF.
          ASSIGN COMPONENT 'TRANSPORT' OF STRUCTURE <sub> TO <f>.
          <f> = c_transport.
        ENDIF.

        " pull
        lv_n = c_ag && '\INTERFACE=ZIF_ABAPGIT_LOG'.
        CREATE DATA lr_log TYPE REF TO (lv_n).
        ASSIGN lr_log->* TO <log>.
        CALL METHOD lo_repo->('ZIF_ABAPGIT_REPO~CREATE_NEW_LOG') EXPORTING iv_title = lv_title RECEIVING ri_log = <log>.
        lo_log = <log>.
        CALL METHOD lo_repo->('ZIF_ABAPGIT_REPO~DESERIALIZE') EXPORTING is_checks = <checks> ii_log = <log>.

        lv_n = c_ag && '\INTERFACE=ZIF_ABAPGIT_LOG\TYPE=TY_LOG_OUTS'.
        CREATE DATA lr_msgs TYPE (lv_n).
        ASSIGN lr_msgs->* TO <msgs>.
        CALL METHOD lo_log->('ZIF_ABAPGIT_LOG~GET_MESSAGES') RECEIVING rt_msg = <msgs>.
        LOOP AT <msgs> ASSIGNING FIELD-SYMBOL(<m>).
          ASSIGN COMPONENT 'TYPE' OF STRUCTURE <m> TO FIELD-SYMBOL(<mt>).
          ASSIGN COMPONENT 'TEXT' OF STRUCTURE <m> TO FIELD-SYMBOL(<mx>).
          out->write( |LOG { <mt> } { <mx> }| ).
        ENDLOOP.
        out->write( |DONE| ).
      CATCH cx_root INTO DATA(lx).
        out->write( |ERROR { cl_abap_classdescr=>get_class_name( lx ) }: { lx->get_text( ) }| ).
        DATA(lx_prev) = lx->previous.
        WHILE lx_prev IS BOUND.
          out->write( |  caused by: { lx_prev->get_text( ) }| ).
          lx_prev = lx_prev->previous.
        ENDWHILE.
    ENDTRY.
  ENDMETHOD.

  METHOD payload.
{{PAYLOAD}}
  ENDMETHOD.

ENDCLASS.
