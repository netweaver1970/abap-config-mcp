{
  "name": "abap-config-mcp",
  "version": "1.9.2",
  "description": "Standalone MCP server for SAP ABAP development AND customizing (IMG/SPRO) via the ADT API - works with Claude Code, Cursor, and any MCP-compatible AI client",
  "main": "dist/index.js",
  "bin": {
    "abap-config-mcp": "dist/index.js"
  },
  "author": "Geert Steyaert",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netweaver1970/abap-config-mcp.git"
  },
  "keywords": [
    "abap",
    "sap",
    "mcp",
    "adt",
    "customizing",
    "img",
    "spro",
    "claude",
    "ai"
  ],
  "scripts": {
    "build": "node esbuild.config.js",
    "start": "node dist/index.js",
    "dev": "node --require ts-node/register src/index.ts",
    "test-connection": "node dist/test-connection.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "abap-adt-api": "^8.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
