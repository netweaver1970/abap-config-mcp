          "401": {
            "description": "No SAP logon: missing or unmapped client certificate, or wrong credentials"
          },
          "403": {
            "description": "The SICF node is inactive, or the SAP user may not call it"
          }
        }
      }
    },
    "/abap_dumps": {
      "post": {
        "operationId": "abap_dumps",
        "summary": "Short dumps (ST22)",
        "description": "Recent runtime errors with program, include and line. The caller's own; all users' with S_DEVELOP display for DEBUG. Read-only.",
        "tags": [
          "ABAP (read-only)"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "days": {
                    "type": "integer",
                    "description": "How many days back (default 7, at most 90)",
                    "minimum": 1,
                    "maximum": 90
                  },
                  "all_users": {
                    "type": "boolean",
                    "description": "Everyone's dumps"
                  },
                  "max_rows": {
                    "type": "integer",
                    "description": "At most this many rows",
                    "minimum": 1,
                    "maximum": 1000
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The engine's answer; STATUS says whether it worked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EngineResponse"
                }
              }
            }
          },
          "401": {
            "description": "No SAP logon: missing or unmapped client certificate, or wrong credentials"
          },
          "403": {
            "description": "The SICF node is inactive, or the SAP user may not call it"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EngineResponse": {
        "type": "object",
        "properties": {
          "STATUS": {
            "type": "string",
            "description": "ok, error, or running for a background write"
          },
          "OPERATION": {
            "type": "string"
          },
          "VERSION": {
            "type": "string",
            "description": "Engine version"
          },
          "DRY_RUN": {
            "type": "string",
            "description": "X when nothing was written"
          },
          "MESSAGES": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "What happened, or what stopped and why, in plain sentences"
          },
          "DATA_JSON": {
            "type": "string",
            "description": "The result data as JSON text (rows, definitions, lists)"
          }
        }
      }
    }
  }
}
