    "/abap_syntax": {
      "post": {
        "operationId": "abap_syntax",
        "summary": "Syntax check",
        "description": "Runs SAP's syntax check on an object's active version, or on a program source you supply; saves nothing. Reports the first error. Read-only.",
        "tags": [
          "ABAP (read-only)"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "object_type": {
                    "type": "string",
                    "description": "Object type: PROG program, INCL include, CLAS class, INTF interface, FUGR function group, FUNC function module, TABL, VIEW, DTEL, DOMA, TTYP, TRAN, MSAG",
                    "enum": [
                      "PROG",
                      "INCL",
                      "CLAS",
                      "INTF",
                      "FUGR",
                      "FUNC",
                      "TABL",
                      "VIEW",
                      "DTEL",
                      "DOMA",
                      "TTYP",
                      "TRAN",
                      "MSAG"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "description": "Exact object name, e.g. ZCL_ORDER_API or RFC_READ_TABLE"
                  },
                  "source": {
                    "type": "string",
                    "description": "A complete program source to check instead of the stored one (executable programs only)"
                  }
                },
                "required": [
                  "object_type",
                  "name"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The engine's answer; STATUS says whether it worked",
            "content": {
              "application/json": {
                "schema": {
