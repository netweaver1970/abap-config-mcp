{
  "openapi": "3.0.3",
  "info": {
    "title": "abap-config-mcp ABAP (read-only)",
    "version": "0.11.0",
    "description": "The in-system engine of abap-config-mcp (ZCL_MCP_CUST_ENGINE behind SICF node /sap/bc/zmcp_cust): read-only ABAP: search, source, where-used, versions, packages, text elements, syntax check and short dumps, as the calling SAP user. Each call runs as the SAP user the logon maps to; with SAP Cloud Connector principal propagation that is the end user (X.509 certificate mapped in SAP). Writes are dry runs unless commit is true."
  },
  "servers": [
    {
      "url": "https://{host}:{port}/sap/bc/zmcp_cust",
      "variables": {
        "host": {
          "default": "sap-host"
        },
        "port": {
          "default": "44300"
        }
      }
    }
  ],
  "paths": {
    "/abap_search": {
      "post": {
        "operationId": "abap_search",
        "summary": "Find ABAP objects",
        "description": "Repository objects whose name matches a pattern (* as wildcard), with type, package and description; only objects the user may display. Read-only.",
        "tags": [
          "ABAP (read-only)"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "pattern": {
                    "type": "string",
                    "description": "Name or pattern, e.g. ZCL_ORDER*"
                  },
                  "object_type": {
                    "type": "string",
                    "description": "Object type: PROG program, INCL include, CLAS class, INTF interface, FUGR function group, FUNC function module, TABL, VIEW, DTEL, DOMA, TTYP, TRAN, MSAG",
                    "enum": [
                      "PROG",
                      "INCL",
                      "CLAS",
                      "INTF",
                      "FUGR",
                      "FUNC",
                      "TABL",
                      "VIEW",
                      "DTEL",
                      "DOMA",
                      "TTYP",
                      "TRAN",
                      "MSAG"
                    ]
                  },
                  "max_rows": {
                    "type": "integer",
                    "description": "At most this many rows",
                    "minimum": 1,
                    "maximum": 1000
                  },
                  "language": {
                    "type": "string",
                    "description": "One-character or ISO language (default the logon language)"
                  }
                },
                "required": [
                  "pattern"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The engine's answer; STATUS says whether it worked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EngineResponse"
                }
              }
            }
          },
          "401": {
            "description": "No SAP logon: missing or unmapped client certificate, or wrong credentials"
          },
          "403": {
            "description": "The SICF node is inactive, or the SAP user may not call it"
          }
        }
      }
    },
