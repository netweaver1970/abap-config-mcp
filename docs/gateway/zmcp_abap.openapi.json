      }
    },
    "/abap_source": {
      "post": {
        "operationId": "abap_source",
        "summary": "Read ABAP source",
        "description": "The active source of a program, include, class, interface, function group or function module. For a class, include picks a part. Read-only.",
        "tags": [
          "ABAP (read-only)"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "object_type": {
                    "type": "string",
                    "description": "Object type: PROG program, INCL include, CLAS class, INTF interface, FUGR function group, FUNC function module, TABL, VIEW, DTEL, DOMA, TTYP, TRAN, MSAG",
                    "enum": [
                      "PROG",
                      "INCL",
                      "CLAS",
                      "INTF",
                      "FUGR",
                      "FUNC",
                      "TABL",
                      "VIEW",
                      "DTEL",
                      "DOMA",
                      "TTYP",
                      "TRAN",
                      "MSAG"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "description": "Exact object name, e.g. ZCL_ORDER_API or RFC_READ_TABLE"
                  },
                  "include": {
                    "type": "string",
                    "description": "Class part: main (default), definitions, implementations, macros or testclasses",
                    "enum": [
                      "main",
                      "definitions",
                      "implementations",
                      "macros",
                      "testclasses"
                    ]
                  }
                },
                "required": [
                  "object_type",
                  "name"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The engine's answer; STATUS says whether it worked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EngineResponse"
                }
              }
            }
          },
          "401": {
            "description": "No SAP logon: missing or unmapped client certificate, or wrong credentials"
          },
          "403": {
            "description": "The SICF node is inactive, or the SAP user may not call it"
          }
        }
      }
    },
