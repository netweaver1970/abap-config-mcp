                    "description": "Object type: PROG program, INCL include, CLAS class, INTF interface, FUGR function group, FUNC function module, TABL, VIEW, DTEL, DOMA, TTYP, TRAN, MSAG",
                    "enum": [
                      "PROG",
                      "INCL",
                      "CLAS",
                      "INTF",
                      "FUGR",
                      "FUNC",
                      "TABL",
                      "VIEW",
                      "DTEL",
                      "DOMA",
                      "TTYP",
                      "TRAN",
                      "MSAG"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "description": "Exact object name, e.g. ZCL_ORDER_API or RFC_READ_TABLE"
                  },
                  "language": {
                    "type": "string",
                    "description": "One-character or ISO language (default the logon language)"
                  }
                },
                "required": [
                  "object_type",
                  "name"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The engine's answer; STATUS says whether it worked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EngineResponse"
                }
              }
            }
          },
          "401": {
            "description": "No SAP logon: missing or unmapped client certificate, or wrong credentials"
