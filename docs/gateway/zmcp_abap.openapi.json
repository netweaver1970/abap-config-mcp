    "/abap_tables": {
      "post": {
        "operationId": "abap_tables",
        "summary": "Find tables and views",
        "description": "Database tables and views by name pattern or by a word from their description. Read-only.",
        "tags": [
          "ABAP (read-only)"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "pattern": {
                    "type": "string",
                    "description": "Name pattern, e.g. T001*"
                  },
                  "keyword": {
                    "type": "string",
                    "description": "Word from the description, e.g. plant"
                  },
                  "max_rows": {
                    "type": "integer",
                    "description": "At most this many rows",
                    "minimum": 1,
                    "maximum": 1000
